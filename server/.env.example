PORT=5001
# Local: mongodb://127.0.0.1:27017/smilo  ·  Production: your MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/smilo
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# production = real DB required (no in-memory fallback), no demo patients, no default passwords
NODE_ENV=development
# Clinic time zone. Slots and "today" use server-local time (Render runs in UTC).
TZ=America/Los_Angeles

# First admin, created when the database is empty. Required (10+ chars) in production.
ADMIN_EMAIL=admin@smilo.clinic
ADMIN_PASSWORD=

# Where the frontend lives. Used to build the manage link in confirmation emails.
CLIENT_URL=http://localhost:5273
# Comma-separated origins allowed by CORS, e.g. https://smilo.vercel.app. Empty = any (dev only).
CORS_ORIGINS=

# Booking policy (minutes / days)
CANCEL_WINDOW_MIN=120
LEAD_TIME_MIN=60
MAX_DAYS_AHEAD=60
SLOT_STEP_MIN=15
